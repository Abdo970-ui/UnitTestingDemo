          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200\", function () {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\npm.test(\"Post has the correct id\", function () {\r\n    const post = pm.response.json();\r\n    pm.expect(post.id).to.eql(1);\r\n    pm.expect(post.userId).to.eql(1);\r\n});"
            ]
          }
        }
      ],
